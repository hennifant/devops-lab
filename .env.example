# Database credentials.
# On the deploy target these are written from GitHub Actions secrets.
POSTGRES_USER=devops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devops

# Application settings. All have defaults; these are the defaults, written out so the
# knobs are discoverable.
#LOG_LEVEL=INFO
# Every target is a label value on every check metric, so this is a cardinality ceiling
# rather than a product limit. Creating past it returns 409.
#MAX_TARGETS=50
#MIN_INTERVAL_SECONDS=30

# Deterministic seed data, as name=url,name=url. Empty means the seed does nothing.
# Staging sets this to point at its own stack; production leaves it empty so a target
# deleted through the API does not reappear on the next deploy.
#SEED_TARGETS=api-self=http://api:8000/health

# Gotify. On the deploy target these are written from GitHub Actions secrets.
# GOTIFY_TOKEN is empty on the first deploy: the application token can only be created
# inside Gotify once it is running. Create it, store it as a secret, deploy again.
GOTIFY_ADMIN_PASSWORD=change-me
GOTIFY_TOKEN=

# Local development only.
# Uncomment to run an isolated second stack next to the deployed one.
# Without COMPOSE_PROJECT_NAME this checkout would share containers, volumes and
# network with the deployment.
# The deployment restarts itself after a host reboot; a dev stack should not silently
# reclaim its ports every time you boot the machine.
#RESTART_POLICY=no
#COMPOSE_PROJECT_NAME=devops-lab-dev
#API_PORT=18000
#PROMETHEUS_PORT=19090
#ALERTMANAGER_PORT=19093
#GRAFANA_PORT=13000
