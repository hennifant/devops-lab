# Database credentials.
# On the deploy target these are written from GitHub Actions secrets.
POSTGRES_USER=devops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devops

# Local development only.
# Uncomment to run an isolated second stack next to the deployed one.
# Without COMPOSE_PROJECT_NAME this checkout would share containers, volumes and
# network with the deployment.
# The deployment restarts itself after a host reboot; a dev stack should not silently
# reclaim its ports every time you boot the machine.
#RESTART_POLICY=no
#COMPOSE_PROJECT_NAME=devops-lab-dev
#API_PORT=18000
#PROMETHEUS_PORT=19090
#ALERTMANAGER_PORT=19093
#GRAFANA_PORT=13000
